package com.ti2cc;

import java.util.Scanner;

public class Principal {

	public static void main(String[] args) {

		DAO dao = new DAO();
		dao.conectar();

		Scanner sc = new Scanner(System.in);
		int opcao = 0;

		do {
			System.out.println("\n===== MENU =====");
			System.out.println("1) Listar usuários");
			System.out.println("2) Inserir usuário");
			System.out.println("3) Excluir usuário");
			System.out.println("4) Atualizar usuário");
			System.out.println("5) Sair");
			System.out.print("Escolha uma opção: ");

			opcao = sc.nextInt();

			switch (opcao) {

			case 1: 
				Usuario[] usuarios = dao.getUsuarios();

				if (usuarios != null) {
					for (int i = 0; i < usuarios.length; i++) {
						System.out.println(usuarios[i].toString());
					}
				}
				break;

			case 2: 
				System.out.print("Codigo: ");
				int codigo = sc.nextInt();

				System.out.print("Login: ");
				String login = sc.next();

				System.out.print("Senha: ");
				String senha = sc.next();

				System.out.print("Sexo (M/F): ");
				char sexo = sc.next().charAt(0);

				Usuario novo = new Usuario(codigo, login, senha, sexo);

				if (dao.inserirUsuario(novo)) {
					System.out.println("Usuário inserido com sucesso!");
				}
				break;

			case 3:
				System.out.print("Codigo do usuario a excluir: ");
				int codExcluir = sc.nextInt();

				if (dao.excluirUsuario(codExcluir)) {
					System.out.println("Usuário excluído!");
				}
				break;

			case 4: 
				System.out.print("Codigo do usuario: ");
				int codAtualizar = sc.nextInt();

				System.out.print("Novo login: ");
				String novoLogin = sc.next();

				System.out.print("Nova senha: ");
				String novaSenha = sc.next();

				System.out.print("Sexo (M/F): ");
				char novoSexo = sc.next().charAt(0);

				Usuario u = new Usuario(codAtualizar, novoLogin, novaSenha, novoSexo);

				if (dao.atualizarUsuario(u)) {
					System.out.println("Usuário atualizado!");
				}
				break;

			case 5:
				System.out.println("Saindo...");
				break;

			default:
				System.out.println("Opção inválida!");
			}

		} while (opcao != 5);

		dao.close();
		sc.close();
	}
}
